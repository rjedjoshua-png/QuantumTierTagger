{
  "schemaVersion": 1,
  "id": "communitytiertagger",
  "version": "${version}",
  "name": "CommunityTierTagger",
  "description": "Display player's PvP tiers from any CommunityTierTagger-compatible community in their nametag!",
  "authors": ["uku", "netiyiy (original creator)", "Evantiisx"],
  "contact": {
    "sources": "https://github.com/YOUR-USERNAME/CommunityTierTagger"
  },
  "license": "MPL-2.0",
  "icon": "assets/communitytiertagger/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "net.uku3lig.tiertagger.fabric.TierTaggerFabric"
    ],
    "ukulib": [
      "net.uku3lig.tiertagger.config.UkulibIntegration"
    ]
  },
  "mixins": [
    "CommunityTierTagger.mixins.json"
  ],
  "depends": {
    "minecraft": ">=26.3",
    "fabricloader": ">=0.19",
    "ukulib": "^2.2.0"
  }
}
